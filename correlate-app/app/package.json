{
  "name": "correlate-app",
  "version": "0.1.0",
  "private": true,
  "description": "correlate-app: correlate container telemetry with service logs on a shared, clickable timeline",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "prestart": "npm run build",
    "start": "electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node build/build-main.js",
    "build:renderer": "node build/build-renderer.js",
    "watch:main": "node build/build-main.js --watch",
    "watch:renderer": "node build/build-renderer.js --watch",
    "icons": "node build/icons.js",
    "typecheck": "tsc --noEmit -p renderer/src && tsc --noEmit -p main/src && tsc --noEmit -p build && tsc --noEmit -p tests && tsc --noEmit -p tests/parity/page",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "css": "node build/cttc-css.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.5.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ssh2": "^1.15.6",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "jotai": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.correlate.app",
    "productName": "correlate-app",
    "fileAssociations": [
      {
        "ext": "correlator",
        "name": "correlate project",
        "description": "A correlate-app project",
        "role": "Editor"
      },
      {
        "ext": "recording",
        "name": "correlate recording",
        "description": "A correlate-app recording",
        "role": "Editor"
      },
      {
        "ext": "track",
        "name": "correlate track",
        "description": "A correlate-app track",
        "role": "Editor"
      }
    ]
  }
}
