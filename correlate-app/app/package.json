{
  "name": "correlate-app",
  "version": "0.1.0",
  "private": true,
  "description": "correlate-app: correlate container telemetry with service logs on a shared, clickable timeline",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "prestart": "npm run build",
    "start": "electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node build/build-main.js",
    "build:renderer": "node build/build-renderer.js",
    "watch:main": "node build/build-main.js --watch",
    "watch:renderer": "node build/build-renderer.js --watch",
    "icons": "node build/icons.js",
    "typecheck": "tsc --noEmit -p renderer/src && tsc --noEmit -p main/src && tsc --noEmit -p build && tsc --noEmit -p tests",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ssh2": "^1.15.6",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "jotai": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
